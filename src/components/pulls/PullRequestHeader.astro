---
import Card from '../ui/Card.astro';
import PullRequestBadge from './PullRequestBadge.astro';
import type { PullRequestDetail } from '@/types/pull-request';
import { ExternalLink, GitBranch, Calendar, User } from 'lucide-react';

interface Props {
  pr: PullRequestDetail;
}

const { pr } = Astro.props;

function formatDate(isoStr: string): string {
  try {
    const d = new Date(isoStr);
    return d.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return isoStr;
  }
}
---

<Card class="space-y-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-2">
      <div class="flex flex-wrap items-center gap-2.5">
        <PullRequestBadge state={pr.state} isDraft={pr.isDraft} />
        <span class="font-mono text-lg font-bold text-neutral-400">#{pr.number}</span>
        <h1 class="font-mono text-lg font-bold tracking-tight text-white sm:text-xl">
          {pr.title}
        </h1>
      </div>

      <!-- Branch flow & Author metadata -->
      <div class="flex flex-wrap items-center gap-2.5 pt-1 font-mono text-xs text-neutral-400">
        <div class="flex items-center gap-1.5 text-neutral-300">
          {
            pr.author.avatarUrl ? (
              <img
                src={pr.author.avatarUrl}
                alt={pr.author.username}
                class="h-4 w-4 rounded-full"
                loading="lazy"
              />
            ) : (
              <User className="h-3.5 w-3.5 text-neutral-500" />
            )
          }
          <span class="font-medium text-neutral-200">{pr.author.username}</span>
        </div>

        <span class="text-neutral-700">•</span>
        <span class="flex items-center gap-1">
          <Calendar className="h-3 w-3 text-neutral-500" />
          <span>Opened {formatDate(pr.createdAt)}</span>
        </span>

        {
          pr.mergedAt && (
            <>
              <span class="text-neutral-700">•</span>
              <span class="font-medium text-purple-400">Merged {formatDate(pr.mergedAt)}</span>
            </>
          )
        }

        {
          pr.closedAt && !pr.mergedAt && (
            <>
              <span class="text-neutral-700">•</span>
              <span class="font-medium text-rose-400">Closed {formatDate(pr.closedAt)}</span>
            </>
          )
        }
      </div>

      <!-- Branch badge -->
      <div class="pt-1">
        <span
          class="inline-flex items-center gap-2 rounded border border-neutral-800 bg-neutral-900/80 px-2.5 py-1 font-mono text-xs text-neutral-300"
        >
          <GitBranch className="h-3.5 w-3.5 text-neutral-500" />
          <span class="font-semibold text-white">{pr.baseBranch}</span>
          <span class="text-neutral-500">&larr;</span>
          <span class="font-semibold text-emerald-400">{pr.headBranch}</span>
        </span>
      </div>
    </div>

    <div class="shrink-0 pt-1 sm:pt-0">
      <a
        href={pr.htmlUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-700 bg-neutral-800/80 px-3 py-1.5 font-mono text-xs font-semibold text-neutral-200 transition-colors hover:border-neutral-600 hover:text-white"
      >
        <span>View on GitHub</span>
        <ExternalLink className="h-3.5 w-3.5 text-neutral-400" />
      </a>
    </div>
  </div>

  {
    pr.body && (
      <div class="mt-2 rounded-lg border border-neutral-800/60 bg-neutral-950/40 p-3.5">
        <div class="max-h-36 overflow-y-auto font-mono text-xs leading-relaxed whitespace-pre-line text-neutral-400">
          {pr.body}
        </div>
      </div>
    )
  }
</Card>
