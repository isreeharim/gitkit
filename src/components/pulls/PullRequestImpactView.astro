---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import type { PullRequestImpactReport } from '@/types/pull-request';
import { Network, Info, Folder, FileText, Package } from 'lucide-react';

interface Props {
  report: PullRequestImpactReport;
}

const { report } = Astro.props;

function getDepthBadge(depth: number): {
  label: string;
  variant: 'danger' | 'warning' | 'info' | 'muted';
} {
  if (depth === 0) {
    return { label: 'Direct Change', variant: 'danger' };
  }
  if (depth === 1) {
    return { label: 'Direct Dependent', variant: 'warning' };
  }
  return { label: `Transitive (L${depth})`, variant: 'info' };
}
---

<div class="space-y-6">
  <!-- Disclaimer & Methodology Banner -->
  <div class="rounded-lg border border-neutral-800/80 bg-neutral-900/40 p-4">
    <div class="flex items-start gap-2.5">
      <Info className="mt-0.5 h-4 w-4 shrink-0 text-cyan-400" />
      <div class="space-y-1 font-mono text-xs leading-relaxed text-neutral-400">
        <span class="font-semibold text-neutral-200">Impact Analysis Methodology: </span>
        <span>{report.disclaimer}</span>
      </div>
    </div>
  </div>

  <!-- Downstream Affected Modules (Blast Radius) -->
  <Card class="space-y-4">
    <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-center">
      <div class="flex items-center gap-2">
        <Network className="h-4 w-4 text-purple-400" />
        <h3 class="font-mono text-sm font-semibold tracking-wide text-neutral-200 uppercase">
          Downstream Dependency Blast Radius
        </h3>
        <span class="rounded bg-neutral-800 px-2 py-0.5 font-mono text-xs text-neutral-400">
          {report.affectedModules.length} modules
        </span>
      </div>

      <div class="font-mono text-[11px] text-neutral-500">
        BFS graph traversal from modified files
      </div>
    </div>

    {
      report.affectedModules.length === 0 ? (
        <div class="p-8 text-center font-mono text-xs text-neutral-500">
          No internal dependents detected in the analyzed repository graph.
        </div>
      ) : (
        <div class="overflow-x-auto rounded-lg border border-neutral-800/80">
          <table class="w-full border-collapse text-left font-mono text-xs">
            <thead>
              <tr class="border-b border-neutral-800 bg-neutral-900/60 text-neutral-400">
                <th class="px-3 py-2.5 font-medium">Module Path</th>
                <th class="px-3 py-2.5 text-center font-medium">Impact Level</th>
                <th class="px-3 py-2.5 font-medium">Relationship Context</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-800/60 bg-neutral-950/40">
              {report.affectedModules.map((item) => {
                const badge = getDepthBadge(item.depth);
                return (
                  <tr class="transition-colors hover:bg-neutral-900/40">
                    <td class="max-w-xs truncate px-3 py-2.5 sm:max-w-md">
                      <div class="flex items-center gap-2">
                        <FileText className="h-3.5 w-3.5 shrink-0 text-neutral-400" />
                        <span class="truncate font-medium text-neutral-200" title={item.path}>
                          {item.path}
                        </span>
                      </div>
                    </td>

                    <td class="px-3 py-2.5 text-center">
                      <Badge variant={badge.variant} class="text-[10px]">
                        {badge.label}
                      </Badge>
                    </td>

                    <td
                      class="max-w-sm truncate px-3 py-2.5 text-[11px] text-neutral-400"
                      title={item.reason}
                    >
                      {item.reason}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )
    }
  </Card>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <!-- Directory Churn Concentration -->
    <Card class="space-y-4">
      <div class="flex items-center gap-2">
        <Folder className="h-4 w-4 text-cyan-400" />
        <h3 class="font-mono text-sm font-semibold tracking-wide text-neutral-200 uppercase">
          Directory Change Concentration
        </h3>
      </div>

      <div class="space-y-2">
        {
          report.affectedDirectories.map((dir) => (
            <div class="space-y-1.5 rounded-lg border border-neutral-800/60 bg-neutral-900/30 p-2.5">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="truncate font-semibold text-neutral-200" title={dir.directory}>
                  {dir.directory === '.' ? '(root)' : dir.directory}
                </span>
                <div class="flex items-center gap-2 text-[11px]">
                  <span class="text-neutral-400">{dir.changedFilesCount} files</span>
                  <span class="text-neutral-700">|</span>
                  <span class="text-emerald-400">+{dir.additions}</span>
                  <span class="text-rose-400">-{dir.deletions}</span>
                </div>
              </div>

              {/* Volume bar */}
              <div class="flex items-center gap-2 pt-0.5">
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-neutral-800/80">
                  <div
                    class="h-full rounded-full bg-cyan-400 transition-all duration-300"
                    style={`width: ${Math.max(dir.percentageOfChanges, 4)}%`}
                  />
                </div>
                <span class="w-8 text-right font-mono text-[10px] text-neutral-400">
                  {dir.percentageOfChanges}%
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </Card>

    <!-- Largest Changed Files -->
    <Card class="space-y-4">
      <div class="flex items-center gap-2">
        <FileText className="h-4 w-4 text-emerald-400" />
        <h3 class="font-mono text-sm font-semibold tracking-wide text-neutral-200 uppercase">
          Largest Changed Files
        </h3>
      </div>

      <div class="space-y-2">
        {
          report.largestChangedFiles.map((f, idx) => (
            <div class="flex items-center justify-between rounded-lg border border-neutral-800/60 bg-neutral-900/30 p-2.5 font-mono text-xs">
              <div class="flex max-w-[280px] items-center gap-2 truncate">
                <span class="w-4 text-right text-[11px] text-neutral-500">#{idx + 1}</span>
                <span class="truncate text-neutral-200" title={f.path}>
                  {f.path}
                </span>
              </div>

              <div class="flex shrink-0 items-center gap-2 text-[11px]">
                <span class="font-medium text-emerald-400">+{f.additions}</span>
                <span class="text-neutral-600">/</span>
                <span class="font-medium text-rose-400">-{f.deletions}</span>
                <span class="rounded bg-neutral-800 px-1.5 py-0.5 text-neutral-400">
                  {f.changes} lines
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </Card>
  </div>

  <!-- Direct Dependencies Imported by Changed Files -->
  {
    report.directDependencies.length > 0 && (
      <Card class="space-y-3">
        <div class="flex items-center gap-2">
          <Package className="h-4 w-4 text-amber-400" />
          <h3 class="font-mono text-sm font-semibold tracking-wide text-neutral-200 uppercase">
            Dependencies Imported by Changed Files
          </h3>
          <span class="rounded bg-neutral-800 px-2 py-0.5 font-mono text-xs text-neutral-400">
            {report.directDependencies.length}
          </span>
        </div>

        <div class="flex flex-wrap gap-2 pt-1">
          {report.directDependencies.map((dep) => (
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-800 bg-neutral-900/80 px-2.5 py-1 font-mono text-xs text-neutral-300">
              <span class="h-1.5 w-1.5 rounded-full bg-amber-400" />
              <span>{dep}</span>
            </span>
          ))}
        </div>
      </Card>
    )
  }
</div>
