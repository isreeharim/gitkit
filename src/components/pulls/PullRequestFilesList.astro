---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import type { PullRequestFile, PullRequestFileStatus } from '@/types/pull-request';
import { FileCode, ChevronDown } from 'lucide-react';

interface Props {
  files: readonly PullRequestFile[];
}

const { files } = Astro.props;

function getStatusBadge(status: PullRequestFileStatus): {
  label: string;
  variant: 'success' | 'warning' | 'danger' | 'info';
} {
  switch (status) {
    case 'added':
      return { label: 'Added', variant: 'success' };
    case 'removed':
      return { label: 'Removed', variant: 'danger' };
    case 'renamed':
      return { label: 'Renamed', variant: 'info' };
    case 'modified':
    default:
      return { label: 'Modified', variant: 'warning' };
  }
}
---

<Card class="space-y-4">
  <div class="flex items-center justify-between border-b border-neutral-800/80 pb-3">
    <div class="flex items-center gap-2">
      <FileCode className="h-4 w-4 text-emerald-400" />
      <h3 class="font-mono text-sm font-semibold tracking-wide text-neutral-200 uppercase">
        Changed Files
      </h3>
      <span class="rounded bg-neutral-800 px-2 py-0.5 font-mono text-xs text-neutral-400">
        {files.length}
      </span>
    </div>

    <div class="font-mono text-[11px] text-neutral-500">
      Expandable diff snippets where available
    </div>
  </div>

  {
    files.length === 0 ? (
      <div class="p-8 text-center font-mono text-xs text-neutral-500">
        No changed files reported for this pull request.
      </div>
    ) : (
      <div class="space-y-2">
        {files.map((file) => {
          const badge = getStatusBadge(file.status);
          return (
            <div class="overflow-hidden rounded-lg border border-neutral-800/80 bg-neutral-900/30">
              <div class="flex flex-col gap-2 p-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex max-w-xl items-center gap-2.5 truncate">
                  <Badge variant={badge.variant} class="shrink-0 text-[10px]">
                    {badge.label}
                  </Badge>

                  <span
                    class="truncate font-mono text-xs font-semibold text-neutral-200"
                    title={file.path}
                  >
                    {file.path}
                  </span>

                  {file.previousPath && (
                    <span
                      class="truncate font-mono text-[11px] text-neutral-500"
                      title={`Renamed from ${file.previousPath}`}
                    >
                      (was {file.previousPath})
                    </span>
                  )}
                </div>

                <div class="flex shrink-0 items-center gap-3 self-end font-mono text-xs sm:self-auto">
                  <span class="font-medium text-emerald-400">
                    +{file.additions.toLocaleString()}
                  </span>
                  <span class="text-neutral-600">/</span>
                  <span class="font-medium text-rose-400">-{file.deletions.toLocaleString()}</span>
                  <span class="rounded bg-neutral-800/80 px-1.5 py-0.5 text-[10px] text-neutral-400">
                    {file.changes} {file.changes === 1 ? 'change' : 'changes'}
                  </span>
                </div>
              </div>

              {file.patch && (
                <details class="group border-t border-neutral-800/60 bg-neutral-950/60">
                  <summary class="flex cursor-pointer items-center gap-1.5 px-3 py-1.5 font-mono text-[11px] text-neutral-400 transition-colors select-none hover:text-white">
                    <ChevronDown className="h-3 w-3 transition-transform group-open:rotate-180" />
                    <span>View Diff Snippet</span>
                  </summary>
                  <pre class="max-h-64 overflow-x-auto p-3 font-mono text-[11px] leading-relaxed whitespace-pre text-neutral-300">
                    {file.patch}
                  </pre>
                </details>
              )}
            </div>
          );
        })}
      </div>
    )
  }
</Card>
