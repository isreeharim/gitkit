---

---

<header
  class="sticky top-0 z-50 w-full border-b border-neutral-800/80 bg-neutral-950/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
    <div class="flex items-center gap-3">
      <a href="/" class="group flex items-center gap-2.5">
        <img
          src="/favicon.svg"
          alt="GitKit Logo"
          class="h-6 w-6 rounded-md border border-emerald-500/30 transition-transform group-hover:scale-105"
          width="24"
          height="24"
        />
        <span
          class="text-sm font-semibold tracking-tight text-white transition-colors group-hover:text-emerald-400"
        >
          GitKit
        </span>
      </a>
    </div>

    <nav aria-label="Global" class="flex items-center gap-4 font-mono text-xs">
      <a
        href="https://github.com/isreeharim/gitkit"
        target="_blank"
        rel="noreferrer"
        class="rounded text-neutral-400 transition-colors hover:text-white"
      >
        GitHub
      </a>
    </nav>
  </div>
</header>
