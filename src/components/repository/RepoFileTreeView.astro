---
import type { RepositoryTree } from '@/types/repository';
import { AlertTriangle } from 'lucide-react';
import { formatBytes } from '@/lib/utils';
import { RepoInteractiveFileTree } from './RepoInteractiveFileTree';

interface Props {
  owner?: string;
  repo?: string;
  tree: RepositoryTree;
  defaultBranch: string;
}

const { owner = '', repo = '', tree, defaultBranch } = Astro.props;
---

<div class="rounded-xl border border-neutral-800/80 bg-neutral-900/40 p-6 sm:p-8">
  <!-- Header with Summary Counts -->
  <div
    class="flex flex-col gap-3 border-b border-neutral-800/60 pb-5 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-base font-semibold text-white">Repository File Tree</h2>
        <span class="rounded bg-neutral-800 px-2 py-0.5 font-mono text-[11px] text-neutral-400">
          {defaultBranch}
        </span>
      </div>
      <p class="mt-1 font-mono text-xs text-neutral-500">
        Interactive hierarchical file tree ({tree.totalFiles} files, {tree.totalDirectories} directories)
      </p>
    </div>

    <div class="flex items-center gap-4 font-mono text-xs text-neutral-400">
      <span>
        Total tree size: <span class="text-neutral-200">{formatBytes(tree.totalBytes)}</span>
      </span>
    </div>
  </div>

  <!-- Truncated Notice (for massive repos with capped entries) -->
  {
    tree.truncated && (
      <div class="mt-4 flex items-center gap-2 rounded-md border border-amber-900/60 bg-amber-950/20 p-3 font-mono text-xs text-amber-400">
        <AlertTriangle className="h-4 w-4 shrink-0 text-amber-400" />
        <span>
          Tree indexed: Showing first {tree.entries.length} prioritised items for edge performance.
        </span>
      </div>
    )
  }

  <!-- Interactive Client File Tree -->
  <RepoInteractiveFileTree
    client:only="react"
    owner={owner}
    repo={repo}
    defaultBranch={defaultBranch}
    tree={tree}
  />
</div>
