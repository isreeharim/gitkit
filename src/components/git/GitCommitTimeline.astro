---
import Card from '../ui/Card.astro';
import type { GitCommit } from '@/types/git';
import { GitCommit as GitCommitIcon, ExternalLink, User } from 'lucide-react';

interface Props {
  commits: readonly GitCommit[];
}

const { commits } = Astro.props;

function formatTimestamp(isoString: string): string {
  try {
    const d = new Date(isoString);
    return d.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return isoString;
  }
}
---

<Card class="space-y-4">
  <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-center">
    <div class="flex items-center gap-2">
      <GitCommitIcon className="h-4 w-4 text-emerald-400" />
      <h3 class="font-mono text-sm font-semibold tracking-wide text-neutral-200 uppercase">
        Commit Timeline & Recent Changes
      </h3>
      <span class="rounded bg-neutral-800 px-2 py-0.5 font-mono text-xs text-neutral-400">
        {commits.length} commits
      </span>
    </div>
    <div class="font-mono text-[11px] text-neutral-500">Latest to oldest</div>
  </div>

  {
    commits.length === 0 ? (
      <div class="p-8 text-center font-mono text-xs text-neutral-500">
        No commits found in the analyzed history.
      </div>
    ) : (
      <div class="relative ml-2 space-y-6 border-l border-neutral-800 pl-4 sm:ml-4">
        {commits.map((commit) => (
          <div class="group relative">
            {/* Node Marker */}
            <div class="absolute top-1 -left-[21px] h-2.5 w-2.5 rounded-full border border-neutral-700 bg-neutral-900 transition-colors group-hover:border-emerald-400 group-hover:bg-emerald-500" />

            <div class="space-y-2 rounded-lg border border-neutral-800/80 bg-neutral-900/30 p-3.5 transition-colors hover:border-neutral-700 hover:bg-neutral-900/60">
              {/* Top Header: SHA, Author, Date, Diff */}
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2 font-mono text-xs">
                  <a
                    href={commit.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 rounded bg-neutral-800 px-2 py-0.5 font-bold text-neutral-200 transition-colors hover:bg-neutral-700 hover:text-white"
                    title="View commit on GitHub"
                  >
                    <span>{commit.shortSha}</span>
                    <ExternalLink className="h-2.5 w-2.5 text-neutral-400" />
                  </a>

                  <div class="flex items-center gap-1.5 text-neutral-300">
                    {commit.author.avatarUrl ? (
                      <img
                        src={commit.author.avatarUrl}
                        alt={commit.author.name}
                        class="h-4 w-4 rounded-full"
                        loading="lazy"
                      />
                    ) : (
                      <User className="h-3.5 w-3.5 text-neutral-500" />
                    )}
                    <span class="font-medium text-neutral-200">{commit.author.name}</span>
                  </div>

                  <span class="text-neutral-600">•</span>
                  <span class="text-[11px] text-neutral-400">
                    {formatTimestamp(commit.author.date)}
                  </span>
                </div>

                <div class="flex items-center gap-2 font-mono text-xs">
                  <span class="font-medium text-emerald-400">
                    +{commit.additions.toLocaleString()}
                  </span>
                  <span class="text-neutral-600">/</span>
                  <span class="font-medium text-rose-400">
                    -{commit.deletions.toLocaleString()}
                  </span>
                  {commit.files.length > 0 && (
                    <span class="rounded bg-neutral-800/90 px-1.5 py-0.5 text-[10px] text-neutral-400">
                      {commit.files.length} {commit.files.length === 1 ? 'file' : 'files'}
                    </span>
                  )}
                </div>
              </div>

              {/* Commit Subject & Body */}
              <p class="font-mono text-xs leading-snug font-semibold text-neutral-200">
                {commit.subject}
              </p>
              {commit.body && (
                <p class="max-h-24 overflow-y-auto font-mono text-xs leading-relaxed whitespace-pre-line text-neutral-400">
                  {commit.body}
                </p>
              )}

              {/* Changed Files List preview */}
              {commit.files.length > 0 && (
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {commit.files.slice(0, 5).map((f) => (
                    <span
                      class="inline-flex max-w-[240px] items-center gap-1 truncate rounded border border-neutral-800 bg-neutral-950/80 px-1.5 py-0.5 font-mono text-[10px] text-neutral-400"
                      title={`${f.status}: ${f.path} (+${f.additions}/-${f.deletions})`}
                    >
                      <span
                        class={`h-1.5 w-1.5 rounded-full ${
                          f.status === 'added'
                            ? 'bg-emerald-400'
                            : f.status === 'removed'
                              ? 'bg-rose-400'
                              : 'bg-amber-400'
                        }`}
                      />
                      <span class="truncate">{f.path}</span>
                    </span>
                  ))}
                  {commit.files.length > 5 && (
                    <span class="self-center font-mono text-[10px] text-neutral-500">
                      +{commit.files.length - 5} more
                    </span>
                  )}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    )
  }
</Card>
