---
import Card from '../ui/Card.astro';
import type { RepositoryHealthReport } from '@/types/health';
import { CheckCircle2, AlertTriangle, Shield, Award } from 'lucide-react';

interface Props {
  report: RepositoryHealthReport;
}

const { report } = Astro.props;

// Tier color mappings
const tierTheme = {
  exemplary: {
    bg: 'bg-emerald-950/40',
    border: 'border-emerald-800/60',
    text: 'text-emerald-400',
    accent: 'bg-emerald-500',
  },
  healthy: {
    bg: 'bg-green-950/40',
    border: 'border-green-800/60',
    text: 'text-green-400',
    accent: 'bg-green-500',
  },
  moderate: {
    bg: 'bg-amber-950/40',
    border: 'border-amber-800/60',
    text: 'text-amber-400',
    accent: 'bg-amber-500',
  },
  needs_attention: {
    bg: 'bg-rose-950/40',
    border: 'border-rose-800/60',
    text: 'text-rose-400',
    accent: 'bg-rose-500',
  },
}[report.ratingTier];
---

<Card class="space-y-6">
  <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <!-- Score display & Tier -->
    <div class="flex items-center gap-6">
      <div
        class="relative flex h-24 w-24 shrink-0 items-center justify-center rounded-xl border border-neutral-800 bg-[#0c0d0e]"
      >
        <div class="text-center font-mono">
          <div class="text-3xl font-extrabold tracking-tight text-white">
            {report.overallScore}
          </div>
          <div class="text-[10px] font-semibold tracking-widest text-neutral-500 uppercase">
            / 100
          </div>
        </div>
      </div>

      <div class="space-y-1.5 font-mono">
        <div class="flex items-center gap-2">
          <span
            class={`inline-flex items-center gap-1.5 rounded border px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider ${tierTheme.bg} ${tierTheme.border} ${tierTheme.text}`}
          >
            <Award className="h-3.5 w-3.5" />
            {report.ratingLabel}
          </span>
        </div>
        <p class="max-w-md text-xs text-neutral-400">
          Deterministic composite health score derived from across 7 categories and 25 rule checks.
        </p>
      </div>
    </div>

    <!-- Quick stat counters -->
    <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
      <div
        class="flex items-center gap-2 rounded-lg border border-neutral-800 bg-neutral-900/40 px-3.5 py-2.5"
      >
        <CheckCircle2 className="h-4 w-4 text-emerald-400" />
        <div>
          <div class="font-bold text-neutral-200">{report.totalPositiveFindings}</div>
          <div class="text-[10px] text-neutral-500 uppercase">Rules Passed</div>
        </div>
      </div>

      <div
        class="flex items-center gap-2 rounded-lg border border-neutral-800 bg-neutral-900/40 px-3.5 py-2.5"
      >
        <AlertTriangle className="h-4 w-4 text-amber-400" />
        <div>
          <div class="font-bold text-neutral-200">{report.totalNegativeFindings}</div>
          <div class="text-[10px] text-neutral-500 uppercase">Attention Areas</div>
        </div>
      </div>

      <div
        class="flex items-center gap-2 rounded-lg border border-neutral-800 bg-neutral-900/40 px-3.5 py-2.5"
      >
        <Shield className="h-4 w-4 text-blue-400" />
        <div>
          <div class="font-bold text-neutral-200">{report.categories.length}</div>
          <div class="text-[10px] text-neutral-500 uppercase">Categories</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Overall score bar -->
  <div class="space-y-1.5 font-mono">
    <div class="flex justify-between text-xs text-neutral-400">
      <span>Composite Health Index</span>
      <span class="font-bold text-neutral-200">{report.overallScore}%</span>
    </div>
    <div class="h-2 w-full overflow-hidden rounded-full bg-neutral-800">
      <div
        class={`h-full transition-all duration-300 ${tierTheme.accent}`}
        style={`width: ${Math.max(2, Math.min(100, report.overallScore))}%`}
      >
      </div>
    </div>
  </div>
</Card>
