---
import { ShieldCheck } from 'lucide-react';
import type { HealthMethodology } from '@/types/health';

interface Props {
  methodology: HealthMethodology;
}

const { methodology } = Astro.props;
---

<div class="rounded-lg border border-neutral-800 bg-[#0c0d0e] p-4 font-mono text-xs">
  <div class="flex items-start gap-3">
    <div
      class="mt-0.5 rounded-md border border-emerald-900/60 bg-emerald-950/40 p-1.5 text-emerald-400"
    >
      <ShieldCheck className="h-4 w-4" />
    </div>
    <div class="flex-1 space-y-1.5">
      <div class="flex items-center gap-2">
        <span class="font-semibold tracking-wider text-neutral-200 uppercase">
          Deterministic Scoring Methodology
        </span>
        <span class="rounded bg-neutral-800 px-1.5 py-0.5 text-[10px] text-neutral-400">
          v{methodology.version}
        </span>
      </div>
      <p class="leading-relaxed text-neutral-400">
        {methodology.description}
      </p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 pt-1 text-[11px] text-neutral-500">
        <span class="font-medium text-neutral-400">Category Weights:</span>
        <span>Docs: 20%</span>
        <span>Tests: 20%</span>
        <span>Hygiene: 15%</span>
        <span>Dependencies: 15%</span>
        <span>Maintainability: 10%</span>
        <span>Activity: 10%</span>
        <span>Security: 10%</span>
      </div>
    </div>
  </div>
</div>
