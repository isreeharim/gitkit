---
import Card from '../ui/Card.astro';
import type { CategoryHealthScore, HealthFinding } from '@/types/health';
import { CheckCircle2, AlertTriangle, Info } from 'lucide-react';

interface Props {
  categories: CategoryHealthScore[];
}

const { categories } = Astro.props;

function getFindingTheme(kind: HealthFinding['kind']) {
  if (kind === 'positive') {
    return {
      border: 'border-emerald-900/40',
      bg: 'bg-emerald-950/20',
      badgeBg: 'bg-emerald-950/60 text-emerald-400 border-emerald-800/60',
      icon: CheckCircle2,
      iconColor: 'text-emerald-400',
    };
  }
  if (kind === 'negative') {
    return {
      border: 'border-amber-900/40',
      bg: 'bg-amber-950/20',
      badgeBg: 'bg-amber-950/60 text-amber-400 border-amber-800/60',
      icon: AlertTriangle,
      iconColor: 'text-amber-400',
    };
  }
  return {
    border: 'border-neutral-800',
    bg: 'bg-neutral-900/30',
    badgeBg: 'bg-neutral-800 text-neutral-400 border-neutral-700',
    icon: Info,
    iconColor: 'text-neutral-400',
  };
}
---

<div class="space-y-6">
  {
    categories.map((cat) => {
      const allFindings: HealthFinding[] = [
        ...cat.positiveFindings,
        ...cat.negativeFindings,
        ...cat.neutralFindings,
      ];

      return (
        <Card class="space-y-4">
          {/* Category header */}
          <div class="flex flex-col gap-2 border-b border-neutral-800/80 pb-3 font-mono sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h3 class="text-base font-bold tracking-tight text-white">{cat.label}</h3>
              <p class="text-xs text-neutral-400">
                Category score:{' '}
                <span class="font-semibold text-neutral-200">
                  {cat.score} / {cat.maxScore} pts
                </span>{' '}
                ({cat.percentage}%)
              </p>
            </div>
            <div class="flex items-center gap-2 text-xs">
              <span class="rounded border border-neutral-800 bg-neutral-900 px-2 py-0.5 text-neutral-300">
                {allFindings.length} evaluated rules
              </span>
            </div>
          </div>

          {/* Findings list */}
          <div class="space-y-3 font-mono">
            {allFindings.map((finding) => {
              const theme = getFindingTheme(finding.kind);
              const IconComp = theme.icon;

              return (
                <div class={`rounded-lg border ${theme.border} ${theme.bg} space-y-2 p-3.5`}>
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex items-start gap-2.5">
                      <div class="mt-0.5">
                        <IconComp className={`h-4 w-4 ${theme.iconColor}`} />
                      </div>
                      <div>
                        <div class="flex items-center gap-2">
                          <span class="text-xs font-bold text-white">{finding.ruleName}</span>
                          <span
                            class={`py-0.2 rounded border px-1.5 text-[10px] font-semibold uppercase ${theme.badgeBg}`}
                          >
                            {finding.kind}
                          </span>
                        </div>
                        <p class="mt-0.5 text-xs font-medium text-neutral-200">{finding.summary}</p>
                      </div>
                    </div>

                    <div class="shrink-0 text-right">
                      <span class="rounded border border-neutral-800 bg-neutral-900/90 px-2 py-0.5 text-xs font-semibold text-neutral-300">
                        {finding.pointsAwarded} / {finding.maxPoints} pts
                      </span>
                    </div>
                  </div>

                  {/* Explanation */}
                  <p class="pl-6 text-xs leading-relaxed text-neutral-400">{finding.explanation}</p>

                  {/* Evidence disclosure */}
                  {finding.evidence && (
                    <div class="mt-2 ml-6 space-y-1 rounded border border-neutral-800/80 bg-neutral-950/60 p-2.5 text-[11px]">
                      <div class="text-[10px] font-semibold tracking-wider text-neutral-400 uppercase">
                        Verifiable Evidence:
                      </div>
                      <div class="text-neutral-300">{finding.evidence}</div>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </Card>
      );
    })
  }
</div>
