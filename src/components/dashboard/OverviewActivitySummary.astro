---
import type { GitHistoryAnalysisReport } from '@/types/git';
import { GitCommit, ArrowRight, Clock, User, GitBranch } from 'lucide-react';
import { formatDate } from '@/lib/utils';

interface Props {
  owner: string;
  repo: string;
  defaultBranch: string;
  pushedAt: string;
  gitReport?: GitHistoryAnalysisReport | null;
}

const { owner, repo, defaultBranch, pushedAt, gitReport } = Astro.props;

const recentCommits = gitReport?.recentCommits ? gitReport.recentCommits.slice(0, 4) : [];
---

<div class="rounded-xl border border-neutral-800 bg-[#0e1217] p-5 font-mono shadow-xs">
  <!-- Header -->
  <div class="flex items-center justify-between border-b border-neutral-800/80 pb-3.5">
    <div class="flex items-center gap-2">
      <div class="rounded-md border border-neutral-700 bg-neutral-800/80 p-1.5 text-blue-400">
        <GitCommit className="h-4 w-4" />
      </div>
      <div>
        <h2 class="text-sm font-bold text-white">Recent Git Evolution</h2>
        <p class="text-[11px] text-neutral-400">Commit activity and branch timeline</p>
      </div>
    </div>

    <div class="flex items-center gap-2 text-xs text-neutral-400">
      <div class="flex items-center gap-1">
        <GitBranch className="h-3 w-3 text-neutral-500" />
        <span class="text-neutral-300">{defaultBranch}</span>
      </div>
      <span class="text-neutral-700">•</span>
      <div class="flex items-center gap-1">
        <Clock className="h-3 w-3 text-neutral-500" />
        <span title={pushedAt}>Last push {formatDate(pushedAt)}</span>
      </div>
    </div>
  </div>

  <!-- Commits List -->
  <div class="mt-4">
    {
      recentCommits.length > 0 ? (
        <div class="space-y-2.5">
          {recentCommits.map((c) => {
            const shortSha = c.sha.slice(0, 7);
            const firstLine = c.message.split('\n')[0];
            return (
              <div class="flex items-start justify-between gap-3 rounded-lg border border-neutral-800/60 bg-neutral-900/30 p-2.5 text-xs">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <span class="rounded bg-neutral-800 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-neutral-300">
                      {shortSha}
                    </span>
                    <span class="truncate font-medium text-neutral-200" title={firstLine}>
                      {firstLine}
                    </span>
                  </div>
                  <div class="mt-1 flex items-center gap-3 text-[11px] text-neutral-500">
                    <span class="flex items-center gap-1">
                      <User className="h-3 w-3" />
                      <span>{c.author.name}</span>
                    </span>
                    <span>•</span>
                    <span>{formatDate(c.author.date)}</span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="rounded-lg border border-neutral-800/80 bg-neutral-900/30 p-3 text-xs text-neutral-400">
          Git history available via the Git History & Hotspots tool.
        </div>
      )
    }
  </div>

  <!-- CTA Link -->
  <div class="mt-4 border-t border-neutral-800/80 pt-3 text-right">
    <a
      href={`/${owner}/${repo}/git`}
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-400 transition-colors hover:text-blue-300"
    >
      <span>Explore Full Git History & Code Churn Hotspots</span>
      <ArrowRight className="h-3.5 w-3.5" />
    </a>
  </div>
</div>
