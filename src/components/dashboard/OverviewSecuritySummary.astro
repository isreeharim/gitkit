---
import type { SecurityReport } from '@/types/security';
import { ShieldAlert, ShieldCheck, ArrowRight, AlertCircle } from 'lucide-react';

interface Props {
  owner: string;
  repo: string;
  securityReport: SecurityReport;
}

const { owner, repo, securityReport } = Astro.props;

const summary = securityReport?.summary || {
  totalFindings: 0,
  bySeverity: { critical: 0, high: 0, medium: 0, low: 0, info: 0 },
  byType: { secret: 0, vulnerability: 0, configuration: 0 },
  scannersRun: [],
};
const findings = securityReport?.findings || [];
const isClean = summary.totalFindings === 0;

const topFindings = findings.slice(0, 2);
---

<div class="rounded-xl border border-neutral-800 bg-[#0e1217] p-5 font-mono shadow-xs">
  <!-- Header -->
  <div class="flex items-center justify-between border-b border-neutral-800/80 pb-3.5">
    <div class="flex items-center gap-2">
      <div
        class={`rounded-md border p-1.5 ${
          isClean
            ? 'border-emerald-800/80 bg-emerald-950/40 text-emerald-400'
            : 'border-rose-800/80 bg-rose-950/40 text-rose-400'
        }`}
      >
        {isClean ? <ShieldCheck className="h-4 w-4" /> : <ShieldAlert className="h-4 w-4" />}
      </div>
      <div>
        <h2 class="text-sm font-bold text-white">Security Posture</h2>
        <p class="text-[11px] text-neutral-400">Deterministic secrets, OSV & config audit</p>
      </div>
    </div>

    <div>
      {
        isClean ? (
          <span class="rounded border border-emerald-800/80 bg-emerald-950/50 px-2 py-0.5 text-[10px] font-bold tracking-wider text-emerald-300 uppercase">
            Clean (0 Findings)
          </span>
        ) : (
          <span class="rounded border border-rose-800/80 bg-rose-950/50 px-2 py-0.5 text-[10px] font-bold tracking-wider text-rose-300 uppercase">
            {summary.totalFindings} {summary.totalFindings === 1 ? 'Finding' : 'Findings'}
          </span>
        )
      }
    </div>
  </div>

  <!-- Severity Counters -->
  <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-5">
    <div class="rounded-md border border-neutral-800/60 bg-neutral-900/40 p-2">
      <div class="text-[10px] text-neutral-400">Critical</div>
      <div
        class={`mt-1 text-base font-bold ${
          summary.bySeverity.critical > 0 ? 'text-rose-400' : 'text-neutral-500'
        }`}
      >
        {summary.bySeverity.critical}
      </div>
    </div>

    <div class="rounded-md border border-neutral-800/60 bg-neutral-900/40 p-2">
      <div class="text-[10px] text-neutral-400">High</div>
      <div
        class={`mt-1 text-base font-bold ${
          summary.bySeverity.high > 0 ? 'text-orange-400' : 'text-neutral-500'
        }`}
      >
        {summary.bySeverity.high}
      </div>
    </div>

    <div class="rounded-md border border-neutral-800/60 bg-neutral-900/40 p-2">
      <div class="text-[10px] text-neutral-400">Medium</div>
      <div
        class={`mt-1 text-base font-bold ${
          summary.bySeverity.medium > 0 ? 'text-amber-400' : 'text-neutral-500'
        }`}
      >
        {summary.bySeverity.medium}
      </div>
    </div>

    <div class="rounded-md border border-neutral-800/60 bg-neutral-900/40 p-2">
      <div class="text-[10px] text-neutral-400">Low</div>
      <div
        class={`mt-1 text-base font-bold ${
          summary.bySeverity.low > 0 ? 'text-blue-400' : 'text-neutral-500'
        }`}
      >
        {summary.bySeverity.low}
      </div>
    </div>

    <div class="rounded-md border border-neutral-800/60 bg-neutral-900/40 p-2">
      <div class="text-[10px] text-neutral-400">Info</div>
      <div class="mt-1 text-base font-bold text-neutral-500">{summary.bySeverity.info}</div>
    </div>
  </div>

  <!-- Findings Highlights or Clean State -->
  <div class="mt-4">
    {
      isClean ? (
        <div class="flex items-center gap-2 rounded-lg border border-neutral-800/80 bg-neutral-900/30 p-3 text-xs text-neutral-400">
          <ShieldCheck className="h-4 w-4 text-emerald-400 shrink-0" />
          <span>
            No potential secrets, open CVEs, or high-risk configuration patterns detected in the
            repository tree.
          </span>
        </div>
      ) : (
        <div class="space-y-2">
          {topFindings.map((f) => (
            <div class="flex items-start justify-between gap-3 rounded-lg border border-neutral-800/80 bg-neutral-900/30 p-2.5 text-xs">
              <div class="flex items-start gap-2">
                <AlertCircle className="mt-0.5 h-3.5 w-3.5 text-rose-400 shrink-0" />
                <div>
                  <div class="font-semibold text-neutral-200">{f.message}</div>
                  <div class="mt-0.5 text-[11px] text-neutral-500">
                    {f.file} {f.line ? `:${f.line}` : ''} • {f.detector}
                  </div>
                </div>
              </div>
              <span class="rounded bg-neutral-800 px-1.5 py-0.5 text-[9px] font-semibold text-neutral-300 uppercase">
                {f.severity}
              </span>
            </div>
          ))}
        </div>
      )
    }
  </div>

  <!-- CTA Link -->
  <div class="mt-4 border-t border-neutral-800/80 pt-3 text-right">
    <a
      href={`/${owner}/${repo}/security`}
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-rose-400 transition-colors hover:text-rose-300"
    >
      <span>Explore Full Security Audit & Remediations</span>
      <ArrowRight className="h-3.5 w-3.5" />
    </a>
  </div>
</div>
