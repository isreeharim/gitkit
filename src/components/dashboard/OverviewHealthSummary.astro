---
import type { RepositoryHealthReport } from '@/types/health';
import { HeartPulse, CheckCircle2, AlertTriangle, ArrowRight } from 'lucide-react';

interface Props {
  owner: string;
  repo: string;
  healthReport: RepositoryHealthReport;
}

const { owner, repo, healthReport } = Astro.props;

const tierColors: Record<string, { badge: string; text: string }> = {
  exemplary: {
    badge: 'border-emerald-800/80 bg-emerald-950/50 text-emerald-300',
    text: 'text-emerald-400',
  },
  healthy: {
    badge: 'border-blue-800/80 bg-blue-950/50 text-blue-300',
    text: 'text-blue-400',
  },
  moderate: {
    badge: 'border-amber-800/80 bg-amber-950/50 text-amber-300',
    text: 'text-amber-400',
  },
  needs_attention: {
    badge: 'border-rose-800/80 bg-rose-950/50 text-rose-300',
    text: 'text-rose-400',
  },
};

const tier = tierColors[healthReport.ratingTier] || tierColors.moderate;

// Top 2 positive and top 2 negative findings
const positiveFindings = healthReport.categories
  .flatMap((c) => c.positiveFindings || [])
  .slice(0, 2);

const negativeFindings = healthReport.categories
  .flatMap((c) => c.negativeFindings || [])
  .slice(0, 2);
---

<div class="rounded-xl border border-neutral-800 bg-[#0e1217] p-5 font-mono shadow-xs">
  {/* Header */}
  <div class="flex items-center justify-between border-b border-neutral-800/80 pb-3.5">
    <div class="flex items-center gap-2">
      <div class="rounded-md border border-neutral-700 bg-neutral-800/80 p-1.5 text-emerald-400">
        <HeartPulse className="h-4 w-4" />
      </div>
      <div>
        <h2 class="text-sm font-bold text-white">Repository Health</h2>
        <p class="text-[11px] text-neutral-400">Deterministic 7-category rule assessment</p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <span class="text-lg font-bold text-white">
        {healthReport.overallScore}<span class="text-xs text-neutral-500">/100</span>
      </span>
      <span
        class={`rounded px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ${tier.badge}`}
      >
        {(healthReport.ratingTier || 'moderate').replace('_', ' ')}
      </span>
    </div>
  </div>

  {/* Category Bars Preview */}
  <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-7">
    {
      healthReport.categories.map((cat) => {
        const pct =
          cat.percentage ?? (cat.maxScore > 0 ? Math.round((cat.score / cat.maxScore) * 100) : 0);
        return (
          <div class="rounded-md border border-neutral-800/60 bg-neutral-900/40 p-2">
            <div class="flex items-center justify-between text-[10px] text-neutral-400">
              <span class="truncate">{cat.label.slice(0, 7)}</span>
              <span class="font-semibold text-neutral-300">{pct}%</span>
            </div>
            <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-neutral-800">
              <div
                class={`h-full rounded-full ${
                  pct >= 80 ? 'bg-emerald-500' : pct >= 50 ? 'bg-amber-500' : 'bg-rose-500'
                }`}
                style={`width: ${pct}%`}
              />
            </div>
          </div>
        );
      })
    }
  </div>

  <!-- Key Evidence Highlights -->
  <div class="mt-4 grid grid-cols-1 gap-3 text-xs sm:grid-cols-2">
    {
      positiveFindings.length > 0 && (
        <div class="space-y-1.5">
          <span class="text-[10px] font-semibold tracking-wider text-neutral-500 uppercase">
            Strengths
          </span>
          {positiveFindings.map((f) => (
            <div class="flex items-start gap-1.5 text-neutral-300">
              <CheckCircle2 className="mt-0.5 h-3 w-3 shrink-0 text-emerald-400" />
              <span class="line-clamp-1">{f.summary}</span>
            </div>
          ))}
        </div>
      )
    }

    {
      negativeFindings.length > 0 && (
        <div class="space-y-1.5">
          <span class="text-[10px] font-semibold tracking-wider text-neutral-500 uppercase">
            Opportunities
          </span>
          {negativeFindings.map((f) => (
            <div class="flex items-start gap-1.5 text-neutral-400">
              <AlertTriangle className="mt-0.5 h-3 w-3 shrink-0 text-amber-400" />
              <span class="line-clamp-1">{f.summary}</span>
            </div>
          ))}
        </div>
      )
    }
  </div>

  <!-- CTA Link -->
  <div class="mt-4 border-t border-neutral-800/80 pt-3 text-right">
    <a
      href={`/${owner}/${repo}/health`}
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 transition-colors hover:text-emerald-300"
    >
      <span>Explore Full Health Breakdown & Evidence</span>
      <ArrowRight className="h-3.5 w-3.5" />
    </a>
  </div>
</div>
