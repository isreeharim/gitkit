---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GitKit — Deterministic Repository Inspection & Visualization',
  description = 'Free, open-source-friendly, deterministic developer toolkit for understanding, analyzing, and visualizing GitHub repositories without AI.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body
    class="flex min-h-screen flex-col bg-[#090d16] text-neutral-100 selection:bg-emerald-500/20 selection:text-emerald-300"
  >
    <!-- Top Global Navigation Progress Bar -->
    <div id="global-nav-progress" class="nav-loading-bar" aria-hidden="true"></div>

    <!-- Floating Navigation Status HUD -->
    <aside
      id="global-nav-hud"
      class="pointer-events-none fixed right-5 bottom-5 z-50 flex translate-y-4 items-center gap-2.5 rounded-lg border border-neutral-700/80 bg-neutral-950/95 px-3.5 py-2 font-mono text-xs text-neutral-200 opacity-0 shadow-2xl backdrop-blur-md transition-all duration-200"
      role="status"
      aria-live="polite"
    >
      <svg
        class="h-4 w-4 animate-spin text-cyan-400"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"
        ></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path>
      </svg>
      <span id="global-nav-hud-text">Processing request...</span>
    </aside>

    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (function () {
        let progressTimer = null;
        const bar = document.getElementById('global-nav-progress');
        const hud = document.getElementById('global-nav-hud');
        const hudText = document.getElementById('global-nav-hud-text');

        function startProgress(label) {
          if (!bar) return;
          if (progressTimer) clearInterval(progressTimer);

          bar.classList.add('active');
          bar.style.width = '25%';

          if (hud && hudText) {
            hudText.textContent = label || 'Processing request...';
            hud.classList.remove('opacity-0', 'translate-y-4');
            hud.classList.add('opacity-100', 'translate-y-0');
          }

          let current = 25;
          progressTimer = setInterval(() => {
            if (current < 80) {
              current += Math.random() * 15;
              bar.style.width = current + '%';
            } else if (current < 92) {
              current += 1.5;
              bar.style.width = current + '%';
            }
          }, 180);
        }

        function resetProgress() {
          if (progressTimer) {
            clearInterval(progressTimer);
            progressTimer = null;
          }
          if (bar) {
            bar.style.width = '100%';
            setTimeout(() => {
              bar.classList.remove('active');
              bar.style.width = '0%';
            }, 250);
          }
          if (hud) {
            hud.classList.remove('opacity-100', 'translate-y-0');
            hud.classList.add('opacity-0', 'translate-y-4');
          }
          document.querySelectorAll('[data-nav-active="loading"]').forEach((el) => {
            el.removeAttribute('data-nav-active');
            el.classList.remove('tab-loading-pulse');
            const spinSvg = el.querySelector('.nav-tab-spin');
            if (spinSvg) spinSvg.remove();
            const origIcon = el.querySelector('.nav-tab-icon');
            if (origIcon) origIcon.style.display = '';
          });
        }

        window.addEventListener('pageshow', resetProgress);
        window.addEventListener('load', resetProgress);

        const sectionDescriptions = {
          git: 'Analyzing Git history & commit hotspots...',
          map: 'Rendering interactive repository map...',
          dependencies: 'Resolving dependency graph & manifests...',
          pulls: 'Inspecting pull requests & blast radius...',
          health: 'Calculating deterministic health score...',
          security: 'Running security & vulnerability scan...',
          overview: 'Loading repository overview...',
        };

        document.addEventListener('click', (e) => {
          const link = e.target.closest('a');
          if (!link) return;

          // Ignore modified clicks (cmd, ctrl, shift, right-click, new tab, download)
          if (
            e.defaultPrevented ||
            e.button !== 0 ||
            e.metaKey ||
            e.ctrlKey ||
            e.shiftKey ||
            e.altKey
          )
            return;
          if (link.target && link.target !== '_self') return;
          if (link.hasAttribute('download')) return;

          const href = link.getAttribute('href');
          if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;

          // Check if internal link
          try {
            const url = new URL(link.href, window.location.href);
            if (url.origin !== window.location.origin) return;

            // Ignore same page hash navigation
            if (url.pathname === window.location.pathname && url.search === window.location.search)
              return;

            const section = link.dataset.section;
            const label =
              section && sectionDescriptions[section]
                ? sectionDescriptions[section]
                : 'Loading ' + (link.textContent || 'workspace').trim() + '...';

            if (section) {
              link.setAttribute('data-nav-active', 'loading');
              link.classList.add('tab-loading-pulse');

              const origIcon = link.querySelector('.nav-tab-icon');
              if (origIcon && !link.querySelector('.nav-tab-spin')) {
                origIcon.style.display = 'none';
                const spinSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                spinSvg.setAttribute(
                  'class',
                  'h-3.5 w-3.5 animate-spin text-cyan-400 nav-tab-spin'
                );
                spinSvg.setAttribute('viewBox', '0 0 24 24');
                spinSvg.setAttribute('fill', 'none');
                spinSvg.innerHTML =
                  '<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>';
                link.insertBefore(spinSvg, link.firstChild);
              }
            }

            startProgress(label);
          } catch {
            // Non-URL link
          }
        });
      })();
    </script>
  </body>
</html>
