---
import RootLayout from '../layouts/RootLayout.astro';
import { RepoInput } from '../components/repository/RepoInput';
---

<RootLayout>
  <!-- Hero Section -->
  <section
    class="relative flex min-h-[calc(100vh-120px)] flex-col justify-center px-4 py-16 sm:px-6"
  >
    <div class="mx-auto max-w-3xl text-center">
      <!-- Main Headline -->
      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
        Understand. Analyze. Visualize. <br />
        <span class="font-normal text-neutral-400">Your repositories.</span>
      </h1>

      <!-- Subtitle -->
      <p class="mx-auto mt-5 max-w-xl text-sm leading-relaxed text-neutral-400 sm:text-base">
        Deep repository intelligence via static analysis, concrete dependency graphs, Git history
        hotspots, and verifiable health assessments.
      </p>

      <!-- Repository Input Island -->
      <div class="mt-10">
        <RepoInput client:load />
      </div>
    </div>
  </section>
</RootLayout>
