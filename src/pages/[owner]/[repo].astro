---
import RootLayout from '../../layouts/RootLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import RepoMetadataView from '../../components/repository/RepoMetadataView.astro';
import RepoFileTreeView from '../../components/repository/RepoFileTreeView.astro';
import RepoErrorView from '../../components/repository/RepoErrorView.astro';
import RepoMetricsDashboard from '../../components/repository/RepoMetricsDashboard.astro';
import { validateRepoCoordinates } from '../../lib/github/parse-repo-url';
import { repositoryService } from '../../lib/github/service';
import { ArrowLeft } from 'lucide-react';
import type { RepositoryIngestionResult } from '../../types/repository';
import type { RepositoryMetricsReport } from '../../types/metrics';

const { owner = '', repo = '' } = Astro.params;

const validation = validateRepoCoordinates(owner, repo);

let ingestionResult: RepositoryIngestionResult | null = null;
let metricsReport: RepositoryMetricsReport | null = null;

if (!validation.isValid) {
  Astro.response.status = 404;
} else {
  ingestionResult = await repositoryService.ingestRepository(owner, repo);
  if (!ingestionResult.success) {
    Astro.response.status = ingestionResult.error.status || 404;
  } else {
    metricsReport = await repositoryService.calculateMetrics(
      owner,
      repo,
      ingestionResult.metadata,
      ingestionResult.tree,
      15
    );
  }
}

const pageTitle = ingestionResult?.success
  ? `${ingestionResult.metadata.fullName} — GitKit`
  : validation.isValid
    ? `${owner}/${repo} — GitKit`
    : 'Repository Not Found — GitKit';
---

<RootLayout title={pageTitle}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Breadcrumb & Top Bar -->
    <div
      class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-neutral-900 pb-4"
    >
      <div class="flex items-center gap-2 font-mono text-xs text-neutral-400">
        <a href="/" class="flex items-center gap-1 transition-colors hover:text-white">
          <ArrowLeft className="h-3.5 w-3.5" />
          <span>GitKit</span>
        </a>
        <span class="text-neutral-700">/</span>
        <span class="text-neutral-300">{owner}</span>
        <span class="text-neutral-700">/</span>
        <span class="font-semibold text-white">{repo}</span>
      </div>

      <div class="flex items-center gap-2">
        {
          ingestionResult?.success && (
            <>
              <a
                href={`/${owner}/${repo}/map`}
                class="flex items-center gap-1.5 rounded-lg border border-neutral-700 bg-neutral-800/80 px-2.5 py-1 font-mono text-xs font-semibold text-neutral-300 shadow-sm transition-colors hover:border-neutral-600 hover:text-white"
              >
                <span>Repo Map</span>
              </a>
              <a
                href={`/${owner}/${repo}/dependencies`}
                class="flex items-center gap-1.5 rounded-lg border border-neutral-700 bg-neutral-800/80 px-2.5 py-1 font-mono text-xs font-semibold text-neutral-300 shadow-sm transition-colors hover:border-neutral-600 hover:text-white"
              >
                <span>Dependencies</span>
              </a>
              <a
                href={`/${owner}/${repo}/git`}
                class="flex items-center gap-1.5 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-1 font-mono text-xs font-semibold text-emerald-400 shadow-sm transition-colors hover:bg-emerald-500/20"
              >
                <span>Git History</span>
                <span>&rarr;</span>
              </a>
            </>
          )
        }
        <Badge variant={ingestionResult?.success ? 'success' : 'outline'} class="text-[11px]">
          {ingestionResult?.success ? 'Live Ingestion Active' : 'Phase 2 Route'}
        </Badge>
      </div>
    </div>

    <!-- Coordinate validation failure (404) -->
    {
      !validation.isValid && (
        <RepoErrorView
          owner={owner}
          repo={repo}
          error={{
            kind: 'invalid_repo',
            message: validation.error ?? 'Invalid repository coordinates.',
            status: 404,
          }}
        />
      )
    }

    <!-- GitHub API Ingestion Error View -->
    {
      validation.isValid && ingestionResult && !ingestionResult.success && (
        <RepoErrorView owner={owner} repo={repo} error={ingestionResult.error} />
      )
    }

    <!-- Successful Ingestion View -->
    {
      validation.isValid && ingestionResult && ingestionResult.success && (
        <div class="space-y-8">
          <RepoMetadataView metadata={ingestionResult.metadata} />

          {metricsReport && <RepoMetricsDashboard metrics={metricsReport} />}

          <RepoFileTreeView
            tree={ingestionResult.tree}
            defaultBranch={ingestionResult.metadata.defaultBranch}
          />

          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            <Card class="space-y-3">
              <div class="flex items-center justify-between border-b border-neutral-800/80 pb-2 font-mono text-xs text-neutral-400">
                <span class="font-semibold text-emerald-400">INTERACTIVE REPO MAP</span>
                <span class="rounded border border-emerald-500/20 bg-emerald-500/10 px-2 py-0.5 text-[11px] font-medium text-emerald-400">
                  Live in Phase 3
                </span>
              </div>
              <p class="font-mono text-xs leading-relaxed text-neutral-400">
                Interactive React Flow hierarchy visualization with directory collapsing,
                progressive expansion, real-time file search, and node inspector.
              </p>
              <div class="pt-1">
                <a
                  href={`/${owner}/${repo}/map`}
                  class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-emerald-400 hover:underline"
                >
                  <span>Explore Repository Map</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </Card>

            <Card class="space-y-3">
              <div class="flex items-center justify-between border-b border-neutral-800/80 pb-2 font-mono text-xs text-neutral-400">
                <span class="font-semibold text-cyan-400">DEPENDENCY GRAPH & CYCLES</span>
                <span class="rounded border border-cyan-500/20 bg-cyan-500/10 px-2 py-0.5 text-[11px] font-medium text-cyan-400">
                  Live in Phase 4
                </span>
              </div>
              <p class="font-mono text-xs leading-relaxed text-neutral-400">
                Deterministic module resolution, internal file imports vs external package
                dependencies, cycle detection, manifest parsing, and interactive visual graph.
              </p>
              <div class="pt-1">
                <a
                  href={`/${owner}/${repo}/dependencies`}
                  class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-cyan-400 hover:underline"
                >
                  <span>Explore Dependency Graph</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </Card>

            <Card class="space-y-3">
              <div class="flex items-center justify-between border-b border-neutral-800/80 pb-2 font-mono text-xs text-neutral-400">
                <span class="font-semibold text-rose-400">GIT HISTORY & HOTSPOTS</span>
                <span class="rounded border border-rose-500/20 bg-rose-500/10 px-2 py-0.5 text-[11px] font-medium text-rose-400">
                  Live in Phase 6
                </span>
              </div>
              <p class="font-mono text-xs leading-relaxed text-neutral-400">
                Commit evolution timeline, weekly velocity buckets, and deterministic code churn
                hotspots ranked by frequency, logarithmic volume, and recency decay.
              </p>
              <div class="pt-1">
                <a
                  href={`/${owner}/${repo}/git`}
                  class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-rose-400 hover:underline"
                >
                  <span>Explore Git History</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </Card>
          </div>
        </div>
      )
    }
  </div>
</RootLayout>
