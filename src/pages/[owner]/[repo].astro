---
import RootLayout from '../../layouts/RootLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import RepoMetadataView from '../../components/repository/RepoMetadataView.astro';
import RepoFileTreeView from '../../components/repository/RepoFileTreeView.astro';
import RepoErrorView from '../../components/repository/RepoErrorView.astro';
import { validateRepoCoordinates } from '../../lib/github/parse-repo-url';
import { repositoryService } from '../../lib/github/service';
import { ArrowLeft } from 'lucide-react';
import type { RepositoryIngestionResult } from '../../types/repository';

const { owner = '', repo = '' } = Astro.params;

const validation = validateRepoCoordinates(owner, repo);

let ingestionResult: RepositoryIngestionResult | null = null;

if (!validation.isValid) {
  Astro.response.status = 404;
} else {
  ingestionResult = await repositoryService.ingestRepository(owner, repo);
  if (!ingestionResult.success) {
    Astro.response.status = ingestionResult.error.status || 404;
  }
}

const pageTitle = ingestionResult?.success
  ? `${ingestionResult.metadata.fullName} — GitKit`
  : validation.isValid
    ? `${owner}/${repo} — GitKit`
    : 'Repository Not Found — GitKit';
---

<RootLayout title={pageTitle}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Breadcrumb & Top Bar -->
    <div
      class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-neutral-900 pb-4"
    >
      <div class="flex items-center gap-2 font-mono text-xs text-neutral-400">
        <a href="/" class="flex items-center gap-1 transition-colors hover:text-white">
          <ArrowLeft className="h-3.5 w-3.5" />
          <span>GitKit</span>
        </a>
        <span class="text-neutral-700">/</span>
        <span class="text-neutral-300">{owner}</span>
        <span class="text-neutral-700">/</span>
        <span class="font-semibold text-white">{repo}</span>
      </div>

      <div class="flex items-center gap-3">
        <Badge variant={ingestionResult?.success ? 'success' : 'outline'} class="text-[11px]">
          {ingestionResult?.success ? 'Live Ingestion Active' : 'Phase 2 Route'}
        </Badge>
      </div>
    </div>

    <!-- Coordinate validation failure (404) -->
    {
      !validation.isValid && (
        <RepoErrorView
          owner={owner}
          repo={repo}
          error={{
            kind: 'invalid_repo',
            message: validation.error ?? 'Invalid repository coordinates.',
            status: 404,
          }}
        />
      )
    }

    <!-- GitHub API Ingestion Error View -->
    {
      validation.isValid && ingestionResult && !ingestionResult.success && (
        <RepoErrorView owner={owner} repo={repo} error={ingestionResult.error} />
      )
    }

    <!-- Successful Ingestion View -->
    {
      validation.isValid && ingestionResult && ingestionResult.success && (
        <div class="space-y-8">
          <RepoMetadataView metadata={ingestionResult.metadata} />

          <RepoFileTreeView
            tree={ingestionResult.tree}
            defaultBranch={ingestionResult.metadata.defaultBranch}
          />

          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <Card class="space-y-3">
              <div class="flex items-center justify-between border-b border-neutral-800/80 pb-2 font-mono text-xs text-neutral-400">
                <span class="font-semibold text-neutral-300">AST STATIC ANALYSIS</span>
                <span class="rounded bg-neutral-800/80 px-2 py-0.5 text-[11px] text-neutral-400">
                  Phase 3
                </span>
              </div>
              <p class="font-mono text-xs leading-relaxed text-neutral-400">
                Tree-sitter concrete syntax tree analysis, cyclomatic complexity, Halstead metrics,
                and dependency manifest parsing scheduled for Phase 3.
              </p>
            </Card>

            <Card class="space-y-3">
              <div class="flex items-center justify-between border-b border-neutral-800/80 pb-2 font-mono text-xs text-neutral-400">
                <span class="font-semibold text-neutral-300">INTERACTIVE REPO MAP</span>
                <span class="rounded bg-neutral-800/80 px-2 py-0.5 text-[11px] text-neutral-400">
                  Phase 4
                </span>
              </div>
              <p class="font-mono text-xs leading-relaxed text-neutral-400">
                Interactive React Flow dependency diagrams and D3 codebase topological force graphs
                scheduled for Phase 4.
              </p>
            </Card>
          </div>
        </div>
      )
    }
  </div>
</RootLayout>
