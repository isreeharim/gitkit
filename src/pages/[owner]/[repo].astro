---
import RepoWorkspaceLayout from '../../layouts/RepoWorkspaceLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import RepoMetadataView from '../../components/repository/RepoMetadataView.astro';
import RepoFileTreeView from '../../components/repository/RepoFileTreeView.astro';
import RepoErrorView from '../../components/repository/RepoErrorView.astro';
import RepoMetricsDashboard from '../../components/repository/RepoMetricsDashboard.astro';
import OverviewHealthSummary from '../../components/dashboard/OverviewHealthSummary.astro';
import OverviewSecuritySummary from '../../components/dashboard/OverviewSecuritySummary.astro';
import OverviewActivitySummary from '../../components/dashboard/OverviewActivitySummary.astro';
import OverviewToolsGrid from '../../components/dashboard/OverviewToolsGrid.astro';
import { validateRepoCoordinates } from '../../lib/github/parse-repo-url';
import { repositoryService } from '../../lib/github/service';
import type { RepositoryIngestionResult } from '../../types/repository';
import type { RepositoryMetricsReport } from '../../types/metrics';
import type { RepositoryHealthReport } from '../../types/health';
import type { SecurityReport } from '../../types/security';
import type { GitHistoryAnalysisReport } from '../../types/git';
import { evaluateRepositoryHealth } from '../../lib/analyzer/health';
import { analyzeRepositorySecurity } from '../../lib/security';

const { owner = '', repo = '' } = Astro.params;

const validation = validateRepoCoordinates(owner, repo);

let ingestionResult: RepositoryIngestionResult | null = null;
let metricsReport: RepositoryMetricsReport | null = null;
let healthReport: RepositoryHealthReport | null = null;
let securityReport: SecurityReport | null = null;
let gitReport: GitHistoryAnalysisReport | null = null;

if (!validation.isValid) {
  Astro.response.status = 404;
} else {
  ingestionResult = await repositoryService.ingestRepository(owner, repo);
  if (!ingestionResult.success) {
    Astro.response.status = ingestionResult.error.status || 404;
  } else {
    // 1. Calculate metrics (local AST/LOC from tree)
    metricsReport = await repositoryService.calculateMetrics(
      owner,
      repo,
      ingestionResult.metadata,
      ingestionResult.tree,
      8
    );

    // 2. Fetch lightweight recent commits for activity overview
    try {
      gitReport = await repositoryService.analyzeGitHistory(owner, repo, {
        branch: ingestionResult.metadata.defaultBranch,
        maxCommits: 5,
      });
    } catch {
      // Graceful fallback
    }

    // 3. Evaluate deterministic health (100% local calculation)
    healthReport = evaluateRepositoryHealth({
      metadata: ingestionResult.metadata,
      tree: ingestionResult.tree,
      metrics: metricsReport || undefined,
      commits: gitReport?.recentCommits ? [...gitReport.recentCommits] : undefined,
    });

    // 4. Run deterministic security analysis (local regex patterns)
    securityReport = await analyzeRepositorySecurity({
      metadata: ingestionResult.metadata,
      tree: ingestionResult.tree,
      files: [],
      packages: [],
    });
  }
}

const pageTitle = ingestionResult?.success
  ? `${ingestionResult.metadata.fullName} — GitKit`
  : validation.isValid
    ? `${owner}/${repo} — GitKit`
    : 'Repository Not Found — GitKit';
---

<RepoWorkspaceLayout
  owner={owner}
  repo={repo}
  activeSection="overview"
  title={pageTitle}
  metadata={ingestionResult?.success ? ingestionResult.metadata : undefined}
  metricsReport={metricsReport || undefined}
  healthReport={healthReport || undefined}
  securityReport={securityReport || undefined}
  counts={{
    healthScore: healthReport?.overallScore,
    securityAlerts: securityReport?.summary?.totalFindings,
  }}
>
  {
    !validation.isValid ? (
      <RepoErrorView
        error={{
          status: 404,
          code: 'invalid_coordinates',
          message: 'Invalid GitHub owner or repository name provided.',
          details: validation.error,
        }}
        owner={owner}
        repo={repo}
      />
    ) : ingestionResult && !ingestionResult.success ? (
      <RepoErrorView error={ingestionResult.error} owner={owner} repo={repo} />
    ) : (
      ingestionResult &&
      ingestionResult.success && (
        <div class="space-y-8">
          {/* Live Ingestion Status Banner */}
          <div class="flex items-center justify-between border-b border-neutral-900 pb-3">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500" />
              <Badge
                variant="outline"
                class="border-emerald-900/60 bg-emerald-950/40 text-[11px] font-medium text-emerald-400"
              >
                Live Ingestion Active
              </Badge>
              <span class="font-mono text-xs text-neutral-400">
                Tree synced • {ingestionResult.tree.totalFiles} files indexed
              </span>
            </div>

            <span class="hidden font-mono text-[11px] text-neutral-500 sm:inline">
              Commit SHA: {ingestionResult.tree.sha.slice(0, 7)}
            </span>
          </div>

          {/* Repository Identity & Metadata View */}
          <RepoMetadataView metadata={ingestionResult.metadata} />

          {/* Repository Statistics & Deterministic Metrics */}
          {metricsReport && (
            <RepoMetricsDashboard
              metadata={ingestionResult.metadata}
              tree={ingestionResult.tree}
              metrics={metricsReport}
            />
          )}

          {/* Health & Security Executive Summaries */}
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            {healthReport && (
              <OverviewHealthSummary owner={owner} repo={repo} healthReport={healthReport} />
            )}

            {securityReport && (
              <OverviewSecuritySummary owner={owner} repo={repo} securityReport={securityReport} />
            )}
          </div>

          {/* Recent Git Evolution */}
          <OverviewActivitySummary
            owner={owner}
            repo={repo}
            defaultBranch={ingestionResult.metadata.defaultBranch}
            pushedAt={ingestionResult.metadata.pushedAt}
            gitReport={gitReport}
          />

          {/* Major Analysis Tools Launcher Grid */}
          <OverviewToolsGrid owner={owner} repo={repo} />

          {/* Repository File Tree Explorer */}
          <RepoFileTreeView
            owner={owner}
            repo={repo}
            tree={ingestionResult.tree}
            defaultBranch={ingestionResult.metadata.defaultBranch}
          />
        </div>
      )
    )
  }
</RepoWorkspaceLayout>
