---
import RootLayout from '../../layouts/RootLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import { validateRepoCoordinates } from '../../lib/github/parse-repo-url';
import { GitBranch, ExternalLink, ArrowLeft, AlertCircle, Loader2 } from 'lucide-react';

const { owner, repo } = Astro.params;

const validation = validateRepoCoordinates(owner ?? '', repo ?? '');
const isValid = validation.isValid;

if (!isValid) {
  Astro.response.status = 404;
}

const canonicalUrl = `https://github.com/${owner}/${repo}`;
---

<RootLayout
  title={isValid ? `${owner}/${repo} — GitKit Repository` : 'Repository Not Found — GitKit'}
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Breadcrumb & Top Bar -->
    <div
      class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-neutral-900 pb-4"
    >
      <div class="flex items-center gap-2 font-mono text-xs text-neutral-400">
        <a href="/" class="flex items-center gap-1 transition-colors hover:text-white">
          <ArrowLeft className="h-3.5 w-3.5" />
          <span>GitKit</span>
        </a>
        <span class="text-neutral-700">/</span>
        <span class="text-neutral-300">{owner}</span>
        <span class="text-neutral-700">/</span>
        <span class="font-semibold text-white">{repo}</span>
      </div>

      {
        isValid && (
          <div class="flex items-center gap-3">
            <Badge variant="outline" class="text-[11px] text-neutral-400">
              Phase 1 / Route Active
            </Badge>
            <a
              href={canonicalUrl}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-1.5 rounded-md border border-neutral-800 bg-neutral-900/80 px-2.5 py-1 font-mono text-xs text-neutral-300 transition-colors hover:border-neutral-700 hover:text-white"
            >
              <span>GitHub</span>
              <ExternalLink className="h-3 w-3 text-neutral-400" />
            </a>
          </div>
        )
      }
    </div>

    {/* Invalid Repository 404 View */}
    {
      !isValid ? (
        <div class="rounded-xl border border-red-950/60 bg-red-950/20 p-8 text-center sm:p-12">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-red-800/40 bg-red-900/30 text-red-400">
            <AlertCircle className="h-6 w-6" />
          </div>
          <h1 class="text-xl font-bold tracking-tight text-white sm:text-2xl">
            Repository Not Found
          </h1>
          <p class="mx-auto mt-2 max-w-md font-mono text-xs leading-relaxed text-red-300/80">
            {validation.error ??
              'The specified repository coordinates are invalid according to GitHub naming rules.'}
          </p>
          <div class="mt-6 flex justify-center gap-3">
            <a
              href="/"
              class="inline-flex items-center gap-2 rounded-md border border-neutral-700 bg-neutral-800 px-4 py-2 font-mono text-xs text-neutral-200 transition-colors hover:bg-neutral-700"
            >
              <ArrowLeft className="h-3.5 w-3.5" />
              <span>Return to Search</span>
            </a>
          </div>
        </div>
      ) : (
        <div class="space-y-8">
          {/* Repository Header Card */}
          <div class="rounded-xl border border-neutral-800/80 bg-neutral-900/40 p-6 sm:p-8">
            <div class="flex flex-col gap-4 border-b border-neutral-800/60 pb-6 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <div class="mb-1 flex items-center gap-2 font-mono text-xs text-emerald-400">
                  <GitBranch className="h-3.5 w-3.5" />
                  <span>Repository</span>
                </div>
                <h1 class="font-mono text-2xl font-bold tracking-tight text-white sm:text-3xl">
                  {owner} <span class="font-normal text-neutral-500">/</span> {repo}
                </h1>
              </div>

              <div class="flex items-center gap-2 self-start sm:self-auto">
                <Badge variant="success" class="text-xs">
                  Deterministic Route Validated
                </Badge>
              </div>
            </div>

            {/* Loading notice & Phase disclaimer */}
            <div class="mt-6 rounded-lg border border-neutral-800 bg-neutral-950/60 p-4 font-mono text-xs">
              <div class="flex items-center gap-2.5 text-neutral-300">
                <Loader2 className="h-4 w-4 animate-spin text-emerald-400" />
                <span class="font-semibold text-white">Loading repository information...</span>
              </div>
              <p class="mt-2 border-l-2 border-emerald-500/40 pl-3 leading-relaxed text-neutral-400">
                <strong>Phase 1 Engine Active:</strong> URL and route parameters have been
                successfully parsed and validated. Repository metadata ingestion, Git tree
                inspection, and AST analysis engines will be wired in Phase 2 and Phase 3.
                <br />
                <span class="mt-1 block text-[11px] text-neutral-500">
                  Rule check: No fake repository statistics, fake commit counts, or synthetic AI
                  summaries are displayed.
                </span>
              </p>
            </div>
          </div>

          {/* Repository Workspace Shell Grid (Placeholders for upcoming phases) */}
          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            {/* Metadata Shell Card */}
            <Card class="space-y-3">
              <div class="flex items-center justify-between border-b border-neutral-800/80 pb-2 font-mono text-xs text-neutral-400">
                <span>METADATA ENGINE</span>
                <span class="text-[11px] text-neutral-600">Phase 2</span>
              </div>
              <div class="space-y-2 pt-1">
                <div class="h-3 w-3/4 animate-pulse rounded bg-neutral-800/60" />
                <div class="h-3 w-1/2 animate-pulse rounded bg-neutral-800/40" />
                <div class="h-3 w-2/3 animate-pulse rounded bg-neutral-800/40" />
              </div>
              <p class="pt-2 font-mono text-[11px] text-neutral-500">
                Awaiting public tree & commit metadata connector.
              </p>
            </Card>

            {/* Static Analysis Shell Card */}
            <Card class="space-y-3">
              <div class="flex items-center justify-between border-b border-neutral-800/80 pb-2 font-mono text-xs text-neutral-400">
                <span>AST & METRICS</span>
                <span class="text-[11px] text-neutral-600">Phase 2</span>
              </div>
              <div class="space-y-2 pt-1">
                <div class="h-3 w-2/3 animate-pulse rounded bg-neutral-800/60" />
                <div class="h-3 w-3/5 animate-pulse rounded bg-neutral-800/40" />
                <div class="h-3 w-1/3 animate-pulse rounded bg-neutral-800/40" />
              </div>
              <p class="pt-2 font-mono text-[11px] text-neutral-500">
                Awaiting Tree-sitter AST & cyclomatic metrics engine.
              </p>
            </Card>

            {/* Visualization Shell Card */}
            <Card class="space-y-3">
              <div class="flex items-center justify-between border-b border-neutral-800/80 pb-2 font-mono text-xs text-neutral-400">
                <span>GRAPH TOPOLOGY</span>
                <span class="text-[11px] text-neutral-600">Phase 3</span>
              </div>
              <div class="space-y-2 pt-1">
                <div class="h-3 w-4/5 animate-pulse rounded bg-neutral-800/60" />
                <div class="h-3 w-1/2 animate-pulse rounded bg-neutral-800/40" />
                <div class="h-3 w-3/4 animate-pulse rounded bg-neutral-800/40" />
              </div>
              <p class="pt-2 font-mono text-[11px] text-neutral-500">
                Awaiting React Flow & D3 dependency visualizer.
              </p>
            </Card>
          </div>
        </div>
      )
    }
  </div>
</RootLayout>
