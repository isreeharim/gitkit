---
import RootLayout from '../../../layouts/RootLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import RepoErrorView from '../../../components/repository/RepoErrorView.astro';
import SecuritySummaryCard from '../../../components/security/SecuritySummaryCard.astro';
import SecurityFindingsList from '../../../components/security/SecurityFindingsList.astro';
import SecurityMethodologyBanner from '../../../components/security/SecurityMethodologyBanner.astro';
import { validateRepoCoordinates } from '../../../lib/github/parse-repo-url';
import { repositoryService } from '../../../lib/github/service';
import {
  ArrowLeft,
  GitBranch,
  ExternalLink,
  ShieldAlert,
  Network,
  GitFork,
  GitCommit,
  GitPullRequest,
  HeartPulse,
} from 'lucide-react';
import type { RepositoryIngestionResult } from '../../../types/repository';
import type { SecurityReport } from '../../../types/security';

const { owner = '', repo = '' } = Astro.params;

const validation = validateRepoCoordinates(owner, repo);

let ingestionResult: RepositoryIngestionResult | null = null;
let securityReport: SecurityReport | null = null;

if (!validation.isValid) {
  Astro.response.status = 404;
} else {
  ingestionResult = await repositoryService.ingestRepository(owner, repo);
  if (!ingestionResult.success) {
    Astro.response.status = ingestionResult.error.status || 404;
  } else {
    securityReport = await repositoryService.analyzeRepositorySecurity(owner, repo, {
      metadata: ingestionResult.metadata,
      tree: ingestionResult.tree,
    });
  }
}

const pageTitle = ingestionResult?.success
  ? `Security Audit: ${ingestionResult.metadata.fullName} — GitKit`
  : validation.isValid
    ? `Security Audit: ${owner}/${repo} — GitKit`
    : 'Repository Not Found — GitKit';
---

<RootLayout title={pageTitle}>
  {/* Top Navigation Header */}
  <header
    class="flex h-14 items-center justify-between border-b border-neutral-900 bg-neutral-950 px-4 sm:px-6"
  >
    <div class="flex items-center gap-3">
      <a
        href={`/${owner}/${repo}`}
        class="flex items-center gap-1.5 rounded-md border border-neutral-800 bg-neutral-900/80 px-2.5 py-1 font-mono text-xs text-neutral-300 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white"
      >
        <ArrowLeft className="h-3.5 w-3.5" />
        <span class="hidden sm:inline">Overview</span>
      </a>

      <div class="flex items-center gap-2 font-mono text-xs text-neutral-400">
        <a href="/" class="transition-colors hover:text-white">GitKit</a>
        <span class="text-neutral-700">/</span>
        <a href={`/${owner}/${repo}`} class="text-neutral-300 hover:text-white">{owner}</a>
        <span class="text-neutral-700">/</span>
        <span class="font-semibold text-white">{repo}</span>
        <span class="text-neutral-700">/</span>
        <span class="flex items-center gap-1 font-medium text-rose-400">
          <ShieldAlert className="h-3 w-3" />
          <span>security</span>
        </span>
      </div>
    </div>

    {
      ingestionResult?.success && (
        <div class="flex items-center gap-3">
          <a
            href={`/${owner}/${repo}/map`}
            class="hidden items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900/60 px-2.5 py-1 font-mono text-xs text-neutral-400 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white md:flex"
          >
            <Network className="h-3 w-3 text-emerald-400" />
            <span>Repo Map</span>
          </a>

          <a
            href={`/${owner}/${repo}/dependencies`}
            class="hidden items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900/60 px-2.5 py-1 font-mono text-xs text-neutral-400 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white md:flex"
          >
            <GitFork className="h-3 w-3 text-cyan-400" />
            <span>Dependencies</span>
          </a>

          <a
            href={`/${owner}/${repo}/git`}
            class="hidden items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900/60 px-2.5 py-1 font-mono text-xs text-neutral-400 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white md:flex"
          >
            <GitCommit className="h-3 w-3 text-rose-400" />
            <span>Git History</span>
          </a>

          <a
            href={`/${owner}/${repo}/pulls`}
            class="hidden items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900/60 px-2.5 py-1 font-mono text-xs text-neutral-400 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white md:flex"
          >
            <GitPullRequest className="h-3 w-3 text-purple-400" />
            <span>Pull Requests</span>
          </a>

          <a
            href={`/${owner}/${repo}/health`}
            class="hidden items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900/60 px-2.5 py-1 font-mono text-xs text-neutral-400 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white md:flex"
          >
            <HeartPulse className="h-3 w-3 text-emerald-400" />
            <span>Health</span>
          </a>

          <div class="hidden items-center gap-1.5 font-mono text-xs text-neutral-400 sm:flex">
            <GitBranch className="h-3 w-3 text-neutral-500" />
            <span class="text-neutral-300">{ingestionResult.metadata.defaultBranch}</span>
          </div>

          <a
            href={ingestionResult.metadata.htmlUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden items-center gap-1 font-mono text-xs text-neutral-400 transition-colors hover:text-neutral-200 sm:flex"
          >
            <span>GitHub</span>
            <ExternalLink className="h-3 w-3" />
          </a>

          <Badge variant="rose" class="text-[11px]">
            Security Audit
          </Badge>
        </div>
      )
    }
  </header>

  {/* Main Container */}
  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
    {
      !validation.isValid && (
        <RepoErrorView
          owner={owner}
          repo={repo}
          error={{
            kind: 'invalid_repo',
            message:
              validation.error ||
              'The repository path provided is invalid. Please specify a valid owner and repo name.',
            status: 404,
          }}
        />
      )
    }

    {
      validation.isValid && ingestionResult && !ingestionResult.success && (
        <RepoErrorView owner={owner} repo={repo} error={ingestionResult.error} />
      )
    }

    {
      ingestionResult?.success && securityReport && (
        <div class="space-y-8">
          {/* Page Title Block */}
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-mono text-xs font-semibold tracking-wider text-rose-400 uppercase">
                Deterministic Security Audit
              </span>
              <span class="text-neutral-600">•</span>
              <span class="font-mono text-xs text-neutral-400">Gitleaks & OSV Rule Sets</span>
            </div>
            <h1 class="font-mono text-2xl font-bold tracking-tight text-white sm:text-3xl">
              Security Inspection & Advisory
            </h1>
            <p class="font-mono text-xs text-neutral-400">
              Evaluated secrets, OpenSSF OSV package advisories, and configuration rules for{' '}
              <span class="font-medium text-neutral-200">{ingestionResult.metadata.fullName}</span>.
            </p>
          </div>

          {/* Methodology Banner */}
          <SecurityMethodologyBanner
            version={securityReport.methodology.version}
            detectors={securityReport.methodology.detectors}
          />

          {/* Security Summary Card */}
          <SecuritySummaryCard
            summary={securityReport.summary}
            dependencyScanAvailable={securityReport.dependencyScanAvailable}
          />

          {/* Findings List */}
          <div class="space-y-4 pt-2">
            <div class="flex items-center justify-between font-mono text-xs">
              <span class="font-semibold tracking-wider text-neutral-400 uppercase">
                Identified Security Findings ({securityReport.findings.length})
              </span>
              <span class="text-neutral-500">Ordered by severity</span>
            </div>
            <SecurityFindingsList findings={securityReport.findings} />
          </div>
        </div>
      )
    }
  </main>
</RootLayout>
