---
import RepoWorkspaceLayout from '../../../layouts/RepoWorkspaceLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Card from '../../../components/ui/Card.astro';
import RepoErrorView from '../../../components/repository/RepoErrorView.astro';
import GitHotspotsTable from '../../../components/git/GitHotspotsTable.astro';
import GitActivityChart from '../../../components/git/GitActivityChart.astro';
import GitCommitTimeline from '../../../components/git/GitCommitTimeline.astro';
import { validateRepoCoordinates } from '../../../lib/github/parse-repo-url';
import { repositoryService } from '../../../lib/github/service';
import { Flame, Users, Code2, GitCommit as GitCommitIcon } from 'lucide-react';
import type { RepositoryIngestionResult } from '../../../types/repository';
import type { GitHistoryAnalysisReport } from '../../../types/git';

const { owner = '', repo = '' } = Astro.params;

const validation = validateRepoCoordinates(owner, repo);

let ingestionResult: RepositoryIngestionResult | null = null;
let gitReport: GitHistoryAnalysisReport | null = null;

if (!validation.isValid) {
  Astro.response.status = 404;
} else {
  ingestionResult = await repositoryService.ingestRepository(owner, repo);
  if (!ingestionResult.success) {
    Astro.response.status = ingestionResult.error.status || 404;
  } else {
    gitReport = await repositoryService.analyzeGitHistory(owner, repo, {
      branch: ingestionResult.metadata.defaultBranch,
      maxCommits: 30,
    });
  }
}

const pageTitle = ingestionResult?.success
  ? `Git History & Hotspots: ${ingestionResult.metadata.fullName} — GitKit`
  : validation.isValid
    ? `Git History: ${owner}/${repo} — GitKit`
    : 'Repository Not Found — GitKit';
---

<RepoWorkspaceLayout
  owner={owner}
  repo={repo}
  activeSection="git"
  title={pageTitle}
  metadata={ingestionResult?.success ? ingestionResult.metadata : undefined}
>
  {
    !validation.isValid ? (
      <RepoErrorView
        owner={owner}
        repo={repo}
        error={{
          status: 404,
          code: 'invalid_coordinates',
          message: validation.error ?? 'Invalid repository coordinates.',
        }}
      />
    ) : ingestionResult && !ingestionResult.success ? (
      <RepoErrorView owner={owner} repo={repo} error={ingestionResult.error} />
    ) : (
      ingestionResult &&
      ingestionResult.success &&
      gitReport && (
        <div class="space-y-8">
          {/* Header summary & Provenance */}
          <div class="flex flex-col gap-4 border-b border-neutral-900 pb-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h1 class="flex items-center gap-2 font-mono text-xl font-bold tracking-tight text-white sm:text-2xl">
                <GitCommitIcon className="h-5 w-5 text-emerald-400" />
                <span>Git History & Code Hotspots</span>
              </h1>
              <p class="mt-1 font-mono text-xs text-neutral-400">
                Deterministic commit analysis on branch{' '}
                <span class="text-white">{ingestionResult.metadata.defaultBranch}</span>
              </p>
            </div>

            <div class="flex items-center gap-2">
              <Badge variant="outline" class="border-neutral-800 text-xs">
                {gitReport.summary.totalCommitsAnalyzed} commits analyzed
              </Badge>
              <Badge variant="outline" class="border-neutral-800 text-xs">
                {gitReport.summary.uniqueFilesChangedCount} files changed
              </Badge>
            </div>
          </div>

          {/* 4 Summary Cards Grid */}
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
            <Card class="space-y-1">
              <div class="flex items-center gap-1.5 font-mono text-xs text-neutral-400">
                <GitCommitIcon className="h-3.5 w-3.5 text-neutral-500" />
                <span>Commits Analyzed</span>
              </div>
              <div class="font-mono text-xl font-bold text-white">
                {gitReport.summary.totalCommitsAnalyzed}
              </div>
              <div
                class="truncate font-mono text-[11px] text-neutral-500"
                title={gitReport.samplingNote}
              >
                {gitReport.samplingNote}
              </div>
            </Card>

            <Card class="space-y-1">
              <div class="flex items-center gap-1.5 font-mono text-xs text-neutral-400">
                <Code2 className="h-3.5 w-3.5 text-emerald-500" />
                <span>Net Growth</span>
              </div>
              <div class="font-mono text-xl font-bold text-emerald-400">
                {gitReport.summary.netGrowth >= 0
                  ? `+${gitReport.summary.netGrowth.toLocaleString()}`
                  : gitReport.summary.netGrowth.toLocaleString()}
              </div>
              <div class="font-mono text-[11px] text-neutral-400">
                <span class="text-emerald-400">
                  +{gitReport.summary.totalAdditions.toLocaleString()}
                </span>{' '}
                /{' '}
                <span class="text-rose-400">
                  -{gitReport.summary.totalDeletions.toLocaleString()}
                </span>
              </div>
            </Card>

            <Card class="space-y-1">
              <div class="flex items-center gap-1.5 font-mono text-xs text-neutral-400">
                <Users className="h-3.5 w-3.5 text-cyan-400" />
                <span>Active Authors</span>
              </div>
              <div class="font-mono text-xl font-bold text-white">
                {gitReport.summary.uniqueAuthorsCount}
              </div>
              <div class="font-mono text-[11px] text-neutral-500">In analyzed window</div>
            </Card>

            <Card class="space-y-1">
              <div class="flex items-center gap-1.5 font-mono text-xs text-neutral-400">
                <Flame className="h-3.5 w-3.5 text-rose-400" />
                <span>Hotspots Identified</span>
              </div>
              <div class="font-mono text-xl font-bold text-rose-400">
                {gitReport.hotspots.length}
              </div>
              <div class="font-mono text-[11px] text-neutral-500">
                Across {gitReport.summary.uniqueFilesChangedCount} files changed
              </div>
            </Card>
          </div>

          {/* Activity Over Time */}
          <GitActivityChart timeline={gitReport.activityTimeline} />

          {/* Deterministic Hotspots Table */}
          <GitHotspotsTable
            hotspots={gitReport.hotspots}
            scoringFormula={gitReport.scoringFormula}
          />

          {/* Commit Timeline Feed */}
          <GitCommitTimeline commits={gitReport.recentCommits} />
        </div>
      )
    )
  }
</RepoWorkspaceLayout>
