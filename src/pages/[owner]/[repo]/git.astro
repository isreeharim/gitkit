---
import RootLayout from '../../../layouts/RootLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Card from '../../../components/ui/Card.astro';
import RepoErrorView from '../../../components/repository/RepoErrorView.astro';
import GitHotspotsTable from '../../../components/git/GitHotspotsTable.astro';
import GitActivityChart from '../../../components/git/GitActivityChart.astro';
import GitCommitTimeline from '../../../components/git/GitCommitTimeline.astro';
import { validateRepoCoordinates } from '../../../lib/github/parse-repo-url';
import { repositoryService } from '../../../lib/github/service';
import {
  ArrowLeft,
  GitBranch,
  ExternalLink,
  GitCommit as GitCommitIcon,
  Flame,
  Users,
  Code2,
  Network,
  GitFork,
  GitPullRequest,
  HeartPulse,
  ShieldAlert,
} from 'lucide-react';
import type { RepositoryIngestionResult } from '../../../types/repository';
import type { GitHistoryAnalysisReport } from '../../../types/git';

const { owner = '', repo = '' } = Astro.params;

const validation = validateRepoCoordinates(owner, repo);

let ingestionResult: RepositoryIngestionResult | null = null;
let gitReport: GitHistoryAnalysisReport | null = null;

if (!validation.isValid) {
  Astro.response.status = 404;
} else {
  ingestionResult = await repositoryService.ingestRepository(owner, repo);
  if (!ingestionResult.success) {
    Astro.response.status = ingestionResult.error.status || 404;
  } else {
    gitReport = await repositoryService.analyzeGitHistory(owner, repo, {
      branch: ingestionResult.metadata.defaultBranch,
      maxCommits: 30,
    });
  }
}

const pageTitle = ingestionResult?.success
  ? `Git History & Hotspots: ${ingestionResult.metadata.fullName} — GitKit`
  : validation.isValid
    ? `Git History: ${owner}/${repo} — GitKit`
    : 'Repository Not Found — GitKit';
---

<RootLayout title={pageTitle}>
  <!-- Top Navigation Header -->
  <header
    class="flex h-14 items-center justify-between border-b border-neutral-900 bg-neutral-950 px-4 sm:px-6"
  >
    <div class="flex items-center gap-3">
      <a
        href={`/${owner}/${repo}`}
        class="flex items-center gap-1.5 rounded-md border border-neutral-800 bg-neutral-900/80 px-2.5 py-1 font-mono text-xs text-neutral-300 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white"
      >
        <ArrowLeft className="h-3.5 w-3.5" />
        <span class="hidden sm:inline">Overview</span>
      </a>

      <div class="flex items-center gap-2 font-mono text-xs text-neutral-400">
        <a href="/" class="transition-colors hover:text-white">GitKit</a>
        <span class="text-neutral-700">/</span>
        <a href={`/${owner}/${repo}`} class="text-neutral-300 hover:text-white">{owner}</a>
        <span class="text-neutral-700">/</span>
        <span class="font-semibold text-white">{repo}</span>
        <span class="text-neutral-700">/</span>
        <span class="flex items-center gap-1 font-medium text-emerald-400">
          <GitCommitIcon className="h-3 w-3" />
          <span>git</span>
        </span>
      </div>
    </div>

    {
      ingestionResult?.success && (
        <div class="flex items-center gap-3">
          <a
            href={`/${owner}/${repo}/map`}
            class="hidden items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900/60 px-2.5 py-1 font-mono text-xs text-neutral-400 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white md:flex"
          >
            <Network className="h-3 w-3 text-emerald-400" />
            <span>Repo Map</span>
          </a>

          <a
            href={`/${owner}/${repo}/dependencies`}
            class="hidden items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900/60 px-2.5 py-1 font-mono text-xs text-neutral-400 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white md:flex"
          >
            <GitFork className="h-3 w-3 text-cyan-400" />
            <span>Dependencies</span>
          </a>

          <a
            href={`/${owner}/${repo}/pulls`}
            class="hidden items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900/60 px-2.5 py-1 font-mono text-xs text-neutral-400 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white md:flex"
          >
            <GitPullRequest className="h-3 w-3 text-purple-400" />
            <span>Pull Requests</span>
          </a>

          <a
            href={`/${owner}/${repo}/health`}
            class="hidden items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900/60 px-2.5 py-1 font-mono text-xs text-neutral-400 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white md:flex"
          >
            <HeartPulse className="h-3 w-3 text-emerald-400" />
            <span>Health</span>
          </a>

          <a
            href={`/${owner}/${repo}/security`}
            class="hidden items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900/60 px-2.5 py-1 font-mono text-xs text-neutral-400 transition-colors hover:border-neutral-700 hover:bg-neutral-800 hover:text-white md:flex"
          >
            <ShieldAlert className="h-3 w-3 text-rose-400" />
            <span>Security</span>
          </a>

          <div class="hidden items-center gap-1.5 font-mono text-xs text-neutral-400 sm:flex">
            <GitBranch className="h-3 w-3 text-neutral-500" />
            <span class="text-neutral-300">{ingestionResult.metadata.defaultBranch}</span>
          </div>

          <a
            href={ingestionResult.metadata.htmlUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden items-center gap-1 font-mono text-xs text-neutral-400 transition-colors hover:text-neutral-200 sm:flex"
          >
            <span>GitHub</span>
            <ExternalLink className="h-3 w-3" />
          </a>

          <Badge variant="success" class="text-[11px]">
            Git History
          </Badge>
        </div>
      )
    }
  </header>

  <!-- Main Container -->
  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
    {
      !validation.isValid && (
        <RepoErrorView
          owner={owner}
          repo={repo}
          error={{
            kind: 'invalid_repo',
            message: validation.error ?? 'Invalid repository coordinates.',
            status: 404,
          }}
        />
      )
    }

    {
      validation.isValid && ingestionResult && !ingestionResult.success && (
        <RepoErrorView owner={owner} repo={repo} error={ingestionResult.error} />
      )
    }

    {
      validation.isValid && ingestionResult && ingestionResult.success && gitReport && (
        <div class="space-y-8">
          {/* Summary Cards Grid */}
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
            <Card class="space-y-1">
              <div class="flex items-center gap-1.5 font-mono text-xs text-neutral-400">
                <GitCommitIcon className="h-3.5 w-3.5 text-neutral-500" />
                <span>Commits Analyzed</span>
              </div>
              <div class="font-mono text-xl font-bold text-white">
                {gitReport.summary.totalCommitsAnalyzed}
              </div>
              <div
                class="truncate font-mono text-[11px] text-neutral-500"
                title={gitReport.samplingNote}
              >
                {gitReport.samplingNote}
              </div>
            </Card>

            <Card class="space-y-1">
              <div class="flex items-center gap-1.5 font-mono text-xs text-neutral-400">
                <Code2 className="h-3.5 w-3.5 text-emerald-500" />
                <span>Net Growth</span>
              </div>
              <div class="font-mono text-xl font-bold text-emerald-400">
                {gitReport.summary.netGrowth >= 0
                  ? `+${gitReport.summary.netGrowth.toLocaleString()}`
                  : gitReport.summary.netGrowth.toLocaleString()}
              </div>
              <div class="font-mono text-[11px] text-neutral-400">
                <span class="text-emerald-400">
                  +{gitReport.summary.totalAdditions.toLocaleString()}
                </span>{' '}
                /{' '}
                <span class="text-rose-400">
                  -{gitReport.summary.totalDeletions.toLocaleString()}
                </span>
              </div>
            </Card>

            <Card class="space-y-1">
              <div class="flex items-center gap-1.5 font-mono text-xs text-neutral-400">
                <Users className="h-3.5 w-3.5 text-cyan-400" />
                <span>Active Authors</span>
              </div>
              <div class="font-mono text-xl font-bold text-white">
                {gitReport.summary.uniqueAuthorsCount}
              </div>
              <div class="font-mono text-[11px] text-neutral-500">In analyzed window</div>
            </Card>

            <Card class="space-y-1">
              <div class="flex items-center gap-1.5 font-mono text-xs text-neutral-400">
                <Flame className="h-3.5 w-3.5 text-rose-400" />
                <span>Hotspots Identified</span>
              </div>
              <div class="font-mono text-xl font-bold text-rose-400">
                {gitReport.hotspots.length}
              </div>
              <div class="font-mono text-[11px] text-neutral-500">
                Across {gitReport.summary.uniqueFilesChangedCount} files changed
              </div>
            </Card>
          </div>

          {/* Deterministic Hotspots Table */}
          <GitHotspotsTable
            hotspots={gitReport.hotspots}
            scoringFormula={gitReport.scoringFormula}
          />

          {/* Activity Over Time */}
          <GitActivityChart timeline={gitReport.activityTimeline} />

          {/* Commit Timeline Feed */}
          <GitCommitTimeline commits={gitReport.recentCommits} />
        </div>
      )
    }
  </main>
</RootLayout>
