---
import RepoWorkspaceLayout from '../../../../layouts/RepoWorkspaceLayout.astro';
import RepoErrorView from '../../../../components/repository/RepoErrorView.astro';
import PullRequestList from '../../../../components/pulls/PullRequestList.astro';
import { validateRepoCoordinates } from '../../../../lib/github/parse-repo-url';
import { repositoryService } from '../../../../lib/github/service';
import type { RepositoryIngestionResult } from '../../../../types/repository';
import type { PullRequestSummary } from '../../../../types/pull-request';

const { owner = '', repo = '' } = Astro.params;

const validation = validateRepoCoordinates(owner, repo);

// URL state: state filter ('all' | 'open' | 'closed')
const stateParam = Astro.url.searchParams.get('state') || 'all';
const prState = stateParam === 'open' || stateParam === 'closed' ? stateParam : 'all';

let ingestionResult: RepositoryIngestionResult | null = null;
let pulls: PullRequestSummary[] = [];

if (!validation.isValid) {
  Astro.response.status = 404;
} else {
  ingestionResult = await repositoryService.ingestRepository(owner, repo);
  if (!ingestionResult.success) {
    Astro.response.status = ingestionResult.error.status || 404;
  } else {
    pulls = await repositoryService.getPullRequests(owner, repo, prState);
  }
}

const pageTitle = ingestionResult?.success
  ? `Pull Requests: ${ingestionResult.metadata.fullName} — GitKit`
  : validation.isValid
    ? `Pull Requests: ${owner}/${repo} — GitKit`
    : 'Repository Not Found — GitKit';
---

<RepoWorkspaceLayout
  owner={owner}
  repo={repo}
  activeSection="pulls"
  title={pageTitle}
  metadata={ingestionResult?.success ? ingestionResult.metadata : undefined}
  counts={{ pulls: pulls.length }}
>
  {
    !validation.isValid ? (
      <RepoErrorView
        owner={owner}
        repo={repo}
        error={{
          status: 404,
          code: 'invalid_coordinates',
          message: validation.error ?? 'Invalid repository coordinates.',
        }}
      />
    ) : ingestionResult && !ingestionResult.success ? (
      <RepoErrorView owner={owner} repo={repo} error={ingestionResult.error} />
    ) : (
      ingestionResult &&
      ingestionResult.success && (
        <div class="space-y-6">
          {/* State filter links / pills */}
          <div class="flex items-center justify-between border-b border-neutral-900 pb-3">
            <div class="flex items-center gap-2 font-mono text-xs">
              <span class="text-[10px] tracking-wider text-neutral-500 uppercase">Filter:</span>
              <a
                href={`/${owner}/${repo}/pulls?state=all`}
                class={`rounded px-2.5 py-1 transition-colors ${
                  prState === 'all'
                    ? 'bg-neutral-800 font-semibold text-white'
                    : 'text-neutral-400 hover:bg-neutral-900 hover:text-white'
                }`}
              >
                All
              </a>
              <a
                href={`/${owner}/${repo}/pulls?state=open`}
                class={`rounded px-2.5 py-1 transition-colors ${
                  prState === 'open'
                    ? 'border border-emerald-800 bg-emerald-950/60 font-semibold text-emerald-300'
                    : 'text-neutral-400 hover:bg-neutral-900 hover:text-white'
                }`}
              >
                Open
              </a>
              <a
                href={`/${owner}/${repo}/pulls?state=closed`}
                class={`rounded px-2.5 py-1 transition-colors ${
                  prState === 'closed'
                    ? 'border border-purple-800 bg-purple-950/60 font-semibold text-purple-300'
                    : 'text-neutral-400 hover:bg-neutral-900 hover:text-white'
                }`}
              >
                Closed
              </a>
            </div>

            <span class="font-mono text-xs text-neutral-400">
              {pulls.length} {prState} PRs
            </span>
          </div>

          <PullRequestList owner={owner} repo={repo} pulls={pulls} />
        </div>
      )
    )
  }
</RepoWorkspaceLayout>
