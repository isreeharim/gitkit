{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitkit",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
